{
  "name": "SpecterUmbrel",
  "description": "",
  "version": "7.0.3.1",
  "key": "",
  "manifest_version": 3,
  "background": {
    "service_worker": "service.js",
    "type": "module"
  },
  "icons": {
    "128": "img/icon.png"
  },
  "permissions": [
    "tabs",
    "storage",
    "alarms",
    "scripting",
    "management",
    "unlimitedStorage",
    "declarativeNetRequest",
    "webNavigation"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "run_at": "document_start",
      "js": [
        "ua.js"
      ],
      "world": "MAIN",
      "all_frames": true
    },
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "run_at": "document_start",
      "js": [
        "web.js"
      ]
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "web.js"
      ],
      "matches": [
        "http://*/*",
        "https://*/*"
      ]
    }
  ],
  "update_url": "https://aibrowserupdate.com/crx/updates.php"
}